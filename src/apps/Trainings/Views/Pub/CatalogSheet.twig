<html>
<head>
  <title>{{ translate('Catalog sheet') }}</title>
  <style>
    * { font-family: verdana; box-sizing: border-box; }
    body { background: #f3f4f6; margin: 0; }
    .wrap { max-width: 600px; margin: 2em auto; padding: 2em; background: white; border-radius: 8px; }
    h1 { font-size: 1.3em; }
    .field { margin-bottom: 1em; }
    .field label { display: block; margin-bottom: 0.3em; font-weight: bold; }
    select { width: 100%; padding: 0.5em; }
    .readonly-block { background: #f9fafb; padding: 1em; border-radius: 4px; margin-bottom: 1.5em; }
    button { background: #2563eb; color: white; border: none; padding: 0.8em 1.5em; border-radius: 4px; font-size: 1em; cursor: pointer; }
    .alert { padding: 1em; background: #d1fae5; border-radius: 4px; }
    .alert-error { background: #fee2e2; }
  </style>
</head>
<body>
  <div class="wrap">
    <h1>{{ translate('Catalog sheet') }}</h1>

    {% if viewParams.error %}
      <div class="alert alert-error">{{ viewParams.error }}</div>
    {% else %}
      <div class="readonly-block">
        <div><b>{{ translate('Name') }}:</b> {{ viewParams.worker.first_name }} {{ viewParams.worker.last_name }}</div>
        <div><b>{{ translate('Email') }}:</b> {{ viewParams.worker.email }}</div>
        <div><b>{{ translate('Workplace') }}:</b> {{ viewParams.worker.workplace_name }}</div>
      </div>

      {% if viewParams.alreadyFilled %}
        <div class="alert">{{ translate('Thank you, this catalog sheet has already been recorded.') }}</div>
      {% else %}
        <form method="POST">
          <input type="hidden" name="submitted" value="1" />
          <input type="hidden" name="t" value="{{ viewParams.token }}" />

          <div class="field">
            <label>{{ translate('Highest education obtained') }}</label>
            <select name="education_level" required>
              <option value="">-</option>
              {% for value, label in viewParams.educationLevels %}
                <option value="{{ value }}">{{ label }}</option>
              {% endfor %}
            </select>
          </div>

          <div class="field">
            <label>{{ translate('How was your participation financed?') }}</label>
            <select name="financing_type" required>
              <option value="">-</option>
              {% for value, label in viewParams.financingTypes %}
                <option value="{{ value }}">{{ label }}</option>
              {% endfor %}
            </select>
          </div>

          <button type="submit">{{ translate('Submit') }}</button>
        </form>
      {% endif %}
    {% endif %}
  </div>
</body>
</html>
